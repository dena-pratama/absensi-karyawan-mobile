# Salin file ini menjadi .env.local lalu isi dari
# Supabase Dashboard → Project Settings → API Keys (project yang SAMA dengan web).
#
# Variabel EXPO_PUBLIC_* ikut dibundel ke dalam app (bisa dibaca siapa pun yang
# membongkar APK) — jadi HANYA isi URL & publishable key. Keamanan data dijaga RLS.
# JANGAN PERNAH taruh SUPABASE_SECRET_KEY / service_role di app mobile.
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
